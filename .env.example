# MetaTrader 5 Configuration
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Server
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# macOS / Linux only: MT5 bridge server started by ./start_mt5_server.sh (leave empty on Windows)
MT5_HOST=
MT5_PORT=18813

# Trading Configuration
SYMBOL=XAUUSD
CAPITAL=5000
CAPITAL_MODE=small

# Lot sizes (per trade). Bot picks one by ML confidence:
#   MAX_LOT      ML >= 65%
#   BASE_LOT     ML 55-65%
#   RECOVERY_LOT ML < 55%, after losses, or high volatility
# Halved (min 0.01) in Sydney session and 22:00-05:59 WIB. Need RECOVERY_LOT <= BASE_LOT <= MAX_LOT.
BASE_LOT=0.01
MAX_LOT=0.02
RECOVERY_LOT=0.01

# Risk Management
MAX_DAILY_LOSS_PERCENT=3.0
MAX_POSITION_SIZE=0.5

# AI Model
ML_MODEL_PATH=models/xgboost_model.json
AI_CONFIDENCE_THRESHOLD=0.65

# Regime Detection
HMM_LOOKBACK=500
HMM_N_REGIMES=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
